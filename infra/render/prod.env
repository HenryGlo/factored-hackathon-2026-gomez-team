# Configuración NO secreta del backend en producción. Es la misma lista que `envVars` de render.yaml (PR del despliegue);
# la usa también scripts/prodlike_up.sh para que el entorno local "prodlike" arranque igual que Render.
# Los secretos (ANTHROPIC_API_KEY, DEMO_PASSWORD, contraseñas de la base) nunca van aquí.
APP_ENV=production
TRUST_PROXY=true
LOG_FORMAT=json
LOG_LEVEL=INFO
BANK_HOME_URL=https://banco-demo.example/
# LLM: la configuración evaluada como `sistema_api`
LLM_PROVIDER=anthropic_api
INTENT_CLASSIFIER=llm
RANKER=rule
CONFIRM_MODE=template
CLARIFY_MODE=auto
# RISK_MODEL no se fija: vale el de backend/config/ml.toml (score calibrado risk-v1)
# Voz con ElevenLabs (docs/llm-data.md: el audio sale a un tercero). Sin ELEVENLABS_API_KEY / ELEVENLABS_VOICE_ID responde
# voice_not_configured y el frontend no muestra la opción.
VOICE_ENABLED=true
# Demo pública con datos ficticios: el login muestra el aviso y los usuarios demo (GET /api/demo/info, sin contraseña)
DEMO_MODE=true
# Protección (docs/security.md): límites de peticiones y presupuesto de LLM
RATE_LIMITS_ENABLED=true
LLM_BUDGET_DAILY_COST_USD=2
LLM_BUDGET_DAILY_CALLS=3000
LLM_BUDGET_SESSION_COST_USD=0.20
LLM_BUDGET_SESSION_CALLS=80
