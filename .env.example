# Clave de la API de Anthropic (Claude). Solo por entorno o en .env (fuera de git); nunca en config versionada.
# La usa LLM_PROVIDER=anthropic_api. En producción va como secreto de la plataforma.
ANTHROPIC_API_KEY=
# Proveedor LLM: anthropic_api (producción: SDK oficial, IDs fijos por nodo), claude_cli (`claude -p` con la
# suscripción, desarrollo) o fake (sin red, para tests y demos).
LLM_PROVIDER=
# Override del modelo por nodo (haiku | sonnet). Valores por defecto en backend/config/llm.toml (ADR-0004).
MODEL_INTENT=
MODEL_EXTRACT=
MODEL_CLARIFY=
MODEL_CONFIRM=
MODEL_EXPLAIN=
MODEL_HANDOFF_SUMMARY=
# Timeout por intento en segundos (por defecto 60) y reintentos antes del fallback seguro (por defecto 1).
# Con anthropic_api, LLM_RETRIES es el max_retries del SDK (429, 529, 5xx y red, con backoff y retry-after).
LLM_TIMEOUT_SECONDS=
LLM_RETRIES=
# PostgreSQL local (infra/docker-compose.yml). Usuario, contraseña y base del contenedor.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Puerto del host para el contenedor (5433 por defecto, para no chocar con un PostgreSQL local).
POSTGRES_PORT=
# Usuario de login del backend (grupo app_rw: lee ref, lee/escribe app). Nunca el superusuario.
APP_DB_USER=
APP_DB_PASSWORD=
# Usuario de login de la consola del banco (grupo app_ro: solo lectura).
CONSOLE_DB_USER=
CONSOLE_DB_PASSWORD=
# Conexión del backend (con APP_DB_USER). Formato postgresql+psycopg://usuario:clave@host:puerto/base.
DATABASE_URL=
# Conexión de la consola (con CONSOLE_DB_USER).
CONSOLE_DATABASE_URL=
# Conexión del dueño de los esquemas (POSTGRES_USER): la usan solo el ETL y Alembic.
ADMIN_DATABASE_URL=
# Base de datos aparte para las pruebas (con el dueño; el nombre DEBE terminar en _test o las pruebas fallan).
TEST_DATABASE_URL=
# Opcional: base *_test para la prueba de tiempos con el dataset completo (por defecto <servidor>/bank_perf_test).
PERF_TEST_DATABASE_URL=
# Ruta a la base DuckDB que construye el pipeline (raw_<tabla> + tablas limpias), fuera del repo.
DUCKDB_PATH=
# Ruta local a la descarga del dataset (CSV particionados), fuera del repo.
RAW_DATA_DIR=
# URI del bucket del dataset; se toma del diccionario de datos, nunca se versiona.
DATASET_S3_URI=
# Credencial de lectura del bucket (del diccionario de datos). Nunca commitear.
AWS_ACCESS_KEY_ID=
# Secreto de lectura del bucket (del diccionario de datos). Nunca commitear.
AWS_SECRET_ACCESS_KEY=
# Región del bucket del dataset.
AWS_DEFAULT_REGION=
# Entorno: development | production (en production las cookies van con Secure).
APP_ENV=
# true → GET /api/demo/info devuelve el aviso de datos ficticios y los usuarios demo con su escenario (nunca la contraseña)
DEMO_MODE=
# Contraseña de TODOS los usuarios demo (scripts/seed_demo_users.py). Mínimo 12 caracteres. Nunca commitear.
DEMO_PASSWORD=
# Minutos de inactividad antes de que venza la sesión (por defecto 30).
SESSION_IDLE_MINUTES=
# Horas máximas de una sesión aunque haya actividad (por defecto 12).
SESSION_MAX_HOURS=
# Límite de intentos de login fallidos: ventana en minutos y máximos por usuario y por IP (por defecto 15, 5 y 20).
LOGIN_WINDOW_MINUTES=
LOGIN_MAX_FAILURES_USER=
LOGIN_MAX_FAILURES_IP=
# Fecha "hoy" simulada para la demo y para la regla R1 (formato YYYY-MM-DD; ver P-08).
REFERENCE_DATE=

# Chat: página inicial del banco (ficticia) para redirigir consultas fuera de alcance, y atajo sin LLM para saludos
BANK_HOME_URL=https://banco-demo.example/
FAST_PATH_ENABLED=true
# Segundos de vida de un confirmation_token (ver P-11).
CONFIRMATION_TOKEN_TTL_SECONDS=
# Horas durante las que se guarda una respuesta asociada a un Idempotency-Key.
IDEMPOTENCY_TTL_HOURS=
# Ruta al artefacto versionado del ranker de transacciones.
RANKER_MODEL_PATH=
# Ruta al artefacto versionado del calibrador de riesgo de fraude.
FRAUD_RISK_MODEL_PATH=
# Número máximo de reintentos por llamada a tool o al LLM (reintentos acotados).
MAX_RETRIES=
# Orígenes permitidos por CORS para el frontend desplegado.
CORS_ALLOWED_ORIGINS=
# URL base de la API que consume el frontend.
PUBLIC_API_BASE_URL=
# Protección (docs/security.md). Valores por defecto en backend/config/security.toml.
# CORS cerrado: dominio del frontend en producción (lista separada por comas). Vacío = mismo origen (proxy de Vite).
CORS_ALLOW_ORIGINS=
# Límites "N/segundos", p. ej. RATE_TURNS_SESSION=20/60. RATE_LIMITS_ENABLED=false solo para el harness.
RATE_LIMITS_ENABLED=
RATE_IP_ALL=
RATE_SESSION_ALL=
RATE_LOGIN_IP=
RATE_TURNS_SESSION=
RATE_TURNS_IP=
RATE_CONVERSATIONS_SESSION=
# Presupuesto de LLM: al superarlo, modo degradado (plantillas y baseline) registrado en la traza.
LLM_BUDGET_DAILY_CALLS=
LLM_BUDGET_DAILY_COST_USD=
LLM_BUDGET_SESSION_CALLS=
LLM_BUDGET_SESSION_COST_USD=
MAX_MESSAGE_CHARS=
# Logs (docs/observability.md): json (por defecto, producción) o text (desarrollo). Nivel: INFO por defecto.
LOG_FORMAT=
LOG_LEVEL=

# Voz con ElevenLabs (prompt 08, A3). Apagada por defecto. La clave y la voz solo por entorno; nunca en el repo ni en el frontend.
VOICE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
